# ----------------------------------------------------------------------
# | Security & Performance Configuration - FinanceToolsLab.com         |
# ----------------------------------------------------------------------

# Enable Rewrite Engine
RewriteEngine On

# 1. Redirect HTTP or WWW (missing trailing slash) directly to HTTPS + non-WWW + Trailing Slash (1 hop)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(.*)\.(xml|txt|html|css|js|png|jpg|jpeg|gif|svg|ico|json|woff|woff2|ttf|eot)$
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://financetoolslab.com/$1/ [L,R=301]

# 2. Redirect HTTP or WWW (with trailing slash or for files/homepage) to HTTPS + non-WWW
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://financetoolslab.com/$1 [L,R=301]

# 3. Add trailing slash to non-WWW, HTTPS requests that are missing it (excluding files and API)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !(.*)\.(xml|txt|html|css|js|png|jpg|jpeg|gif|svg|ico|json|woff|woff2|ttf|eot)$
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ https://financetoolslab.com/$1/ [L,R=301]

# 4. Redirect legacy /calculators/ paths to new root paths
RedirectMatch 301 ^/calculators/([^/]+)/?$ https://financetoolslab.com/$1/

# ----------------------------------------------------------------------
# | HTTP Security Headers                                               |
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    # Protect against clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    
    # Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # Referrer Policy for maximum privacy and SEO
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Restrict dangerous browser features
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    
    # Strict Transport Security (HSTS)
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ----------------------------------------------------------------------
# | Gzip / Deflate Compression for Speed                                |
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ----------------------------------------------------------------------
# | Browser Caching Rules                                               |
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images, icons, and media
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Fonts
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    
    # CSS and JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    
    # HTML and XML
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType application/xml "access plus 1 hour"
    ExpiresByType text/xml "access plus 1 hour"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>
